# Database (Supabase/Neon)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=3&pool_timeout=20"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Auth.js
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL="http://localhost:3000"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="StoreHike <onboarding@resend.dev>"

# Flutterwave
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_SECRET_HASH=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin (/admin) — a single shared password, not a database account
ADMIN_PASSWORD=""

# Upstash Redis — powers rate limiting (login, admin login, register, forgot-password).
# Rate limiting silently no-ops if these are unset, so local dev works without them.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
