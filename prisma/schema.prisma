// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  // "native" covers local dev (Windows); "rhel-openssl-3.0.x" is Vercel's actual Lambda
  // runtime, which differs from its build machine — without this, prisma generate (run
  // via postinstall during the Vercel build) produces an engine binary that works during
  // build but can't be found at runtime, failing every single database call in production.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth.js ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)

  accounts Account[]
  sessions Session[]
  stores   Store[]
  storeMemberships StoreMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Store ----------

model Store {
  id                      String  @id @default(cuid())
  userId                  String
  name                    String
  slug                    String  @unique
  customDomain            String? @unique
  logoUrl                 String?
  bannerUrl               String?
  description             String?
  phone                   String?
  whatsappNumber          String?
  email                   String?
  address                 String?
  currency                String  @default("NGN")
  theme                   Json?
  socialLinks             Json?
  announcementText        String?
  announcementEnabled     Boolean @default(false)
  isPublished             Boolean @default(false)
  paystackPublicKey       String?
  bankAccountVerified     Boolean @default(false)
  bankName                String?
  // Paystack's own bank code for bankName (e.g. "058" for GTBank) — needed to create the
  // Paystack subaccount below; free-typed bankName alone isn't enough for their API.
  bankCode                String?
  bankAccountNumber       String?
  bankAccountName         String?
  // Lazily created (see getOrCreateStoreSubaccount in orders.ts) once bankAccountVerified is
  // true, purely so pooled Dedicated Virtual Accounts can show this store's name instead of
  // the platform's own — set with percentage_charge: 100 so nothing auto-settles to the
  // seller's bank; the pooled ledger stays the only payout path.
  paystackSubaccountCode  String?
  isSuspended             Boolean @default(false)
  suspendedAt             DateTime?
  suspendedReason         String?
  niche                   StoreNiche @default(OTHER)

  // Cached running total of this store's pooled-collection earnings, in Naira. Always
  // updated inside the same transaction as the LedgerEntry that changes it — never
  // written to directly — so it stays in lockstep with the entries below.
  ledgerBalance           Decimal @default(0) @db.Decimal(10, 2)
  // Only applies to pooled-collection payments (no Paystack account of their own).
  // LEDGER: proceeds sit in ledgerBalance until the seller withdraws. INSTANT_PAYOUT:
  // a Transfer to their connected bank account is attempted right after each sale.
  settlementPreference    SettlementPreference @default(LEDGER)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  categories    Category[]
  products      Product[]
  customers     Customer[]
  orders        Order[]
  shippingZones ShippingZone[]
  discounts     Discount[]
  carts         Cart[]
  subscription  Subscription?
  members       StoreMember[]
  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum StoreNiche {
  FASHION_APPAREL
  CLOTHING
  BEAUTY_SKINCARE
  ELECTRONICS_GADGETS
  TECH
  FOOD_GROCERIES
  HOME_LIVING
  KIDS_BABY
  HEALTH_WELLNESS
  BOOKS_STATIONERY
  ARTS_CRAFTS
  AUTOMOBILES
  OTHER
}

model Category {
  id        String  @id @default(cuid())
  storeId   String
  name      String
  slug      String
  imageUrl  String?
  sortOrder Int     @default(0)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
}

model Product {
  id             String   @id @default(cuid())
  storeId        String
  categoryId     String?
  name           String
  slug           String
  description    String?
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  costPrice      Decimal? @db.Decimal(10, 2)
  sku            String?
  trackInventory Boolean  @default(true)
  stockQuantity  Int      @default(0)
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  weight         Float?
  sortOrder      Int      @default(0)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([storeId])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  name          String
  options       Json
  price         Decimal? @db.Decimal(10, 2)
  sku           String?
  stockQuantity Int      @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

// A cross-device cart, keyed by phone number so a customer can pick up the
// same cart on a different device without creating an account. Items are
// stored as a JSON snapshot (id/qty/display fields) rather than relations —
// carts are ephemeral and always re-validated against live product data at
// checkout, so there's no need for referential integrity here.
model Cart {
  id      String @id @default(cuid())
  storeId String
  phone   String
  items   Json

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, phone])
}

model Customer {
  id          String  @id @default(cuid())
  storeId     String
  name        String
  phone       String
  email       String?
  addresses   Json?
  totalOrders Int     @default(0)
  totalSpent  Decimal @default(0) @db.Decimal(10, 2)

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, phone])
  @@index([storeId])
}

model Order {
  id               String        @id @default(cuid())
  storeId          String
  customerId       String
  orderNumber      String
  status           OrderStatus   @default(PENDING)
  subtotal         Decimal       @db.Decimal(10, 2)
  shippingCost     Decimal       @default(0) @db.Decimal(10, 2)
  discount         Decimal       @default(0) @db.Decimal(10, 2)
  discountCode     String?
  total            Decimal       @db.Decimal(10, 2)
  paymentMethod     PaymentMethod
  paystackReference String?       @unique
  shippingAddress  Json
  customerNote     String?
  trackingNote     String?

  // Set only for pooled-collection bank transfer (seller has no Paystack account of their
  // own) — a fresh Dedicated Virtual Account created for this order alone. customerCode is
  // needed to deactivate the account once paid or expired; the account/bank fields let the
  // checkout page redisplay the same details on a refresh instead of creating a new one.
  paystackDvaCustomerCode  String?
  // Paystack's own numeric ID for the dedicated account (distinct from customerCode) —
  // needed to deactivate it later; customerCode alone identifies who to match a webhook
  // charge back to, not how to deactivate the account.
  paystackDvaAccountId     String?
  paystackDvaAccountNumber String?
  paystackDvaBankName      String?
  expiresAt                DateTime?

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  ledgerEntry LedgerEntry?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?

  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([customerId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  productName String
  variantName String?
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model ShippingZone {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  states    String[]
  rate      Decimal  @db.Decimal(10, 2)
  freeAbove Decimal? @db.Decimal(10, 2)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

model Discount {
  id            String       @id @default(cuid())
  storeId       String
  code          String
  type          DiscountType
  value         Decimal      @db.Decimal(10, 2)
  minOrderValue Decimal?     @db.Decimal(10, 2)
  usageLimit    Int?
  usageCount    Int          @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean      @default(true)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, code])
  @@index([storeId])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  // Pooled bank-transfer order whose 30-minute virtual account window closed unpaid —
  // see the expiry sweep. Distinct from CANCELLED, which is a seller/buyer decision.
  EXPIRED
}

enum PaymentMethod {
  PAYSTACK
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

enum SettlementPreference {
  LEDGER
  INSTANT_PAYOUT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ---------- Seller ledger ----------

// Pooled-collection money only: credited when a buyer pays into the platform's own
// Paystack account on a seller's behalf (seller has no Paystack account of their own)
// and debited when the seller withdraws. Orders paid straight into a seller's own
// Paystack account, or via their own manually-displayed bank details, never touch this —
// the platform never held that money, so there's nothing to reconcile.
model LedgerEntry {
  id      String            @id @default(cuid())
  storeId String
  orderId String?           @unique
  type    LedgerEntryType
  reason  LedgerEntryReason
  status  LedgerEntryStatus @default(COMPLETED)
  amount  Decimal           @db.Decimal(10, 2)
  // Idempotency key: the Paystack transaction reference for a credit, or our own
  // generated reference for a withdrawal payout. Prevents a replayed webhook or a
  // double-submitted withdrawal from being applied twice.
  reference String? @unique
  note      String?

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum LedgerEntryReason {
  ORDER_PAYMENT
  WITHDRAWAL
  ADJUSTMENT
}

enum LedgerEntryStatus {
  PENDING
  COMPLETED
  FAILED
}

// ---------- Billing ----------

model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  monthlyPrice Decimal  @db.Decimal(10, 2)
  yearlyPrice  Decimal  @db.Decimal(10, 2)
  currency     String   @default("NGN")
  features     Json?
  // Max products a store on this plan may have. null = unlimited. Stores with
  // no Subscription row at all (the default for new signups) fall back to the
  // hardcoded FREE_PRODUCT_LIMIT in src/lib/plan-limits.ts, not a DB row here.
  productLimit Int?
  // Which tier of gated features this plan unlocks — see FEATURE_TIER in
  // src/lib/plan-features.ts for what each level requires. 0 = Free-equivalent.
  // An explicit admin-set number rather than inferring from the plan's slug/name,
  // so renaming a plan later can't silently change what it unlocks.
  featureTier  Int      @default(0)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)

  // Paystack "Plan" codes, one per billing interval, created lazily (self-provisioned)
  // the first time a seller subscribes at that cycle — see getOrCreatePaystackPlanCode
  // in src/lib/actions/billing.ts.
  paystackMonthlyPlanCode  String?
  paystackBiannualPlanCode String?
  paystackAnnualPlanCode   String?

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id               String             @id @default(cuid())
  storeId          String             @unique
  planId           String
  interval         BillingInterval    @default(MONTHLY)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  canceledAt       DateTime?
  notes            String?
  // Paystack's own customer_code (data.customer.customer_code on a charge webhook) — the
  // reliable key for matching a later auto-renewal back to this subscription, since a
  // renewal's reference is generated by Paystack and we don't control it.
  paystackCustomerCode String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan  Plan  @relation(fields: [planId], references: [id], onDelete: Restrict)

  payments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
}

// One row per successful Paystack charge (initial subscribe or each
// recurring auto-renewal) — gives idempotency on txRef for the webhook and a
// payment history.
model SubscriptionPayment {
  id             String   @id @default(cuid())
  subscriptionId String
  txRef          String   @unique
  amount         Decimal  @db.Decimal(10, 2)
  currency       String
  status         String

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([subscriptionId])
}

enum BillingInterval {
  MONTHLY
  BIANNUAL
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// ---------- Staff accounts (Business tier) ----------

// The store owner is still Store.userId — this is only for additional staff.
// PENDING rows may have no userId yet (invited by email, no account linked
// until they accept); ACTIVE rows always have one.
model StoreMember {
  id          String            @id @default(cuid())
  storeId     String
  userId      String?
  email       String
  status      StoreMemberStatus @default(PENDING)
  inviteToken String?           @unique
  invitedAt   DateTime          @default(now())
  acceptedAt  DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, email])
  @@index([storeId])
  @@index([userId])
}

enum StoreMemberStatus {
  PENDING
  ACTIVE
}
